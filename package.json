{
  "name": "qa-automation-node-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js test framework combining Playwright browser automation with unit, API, and data-layer verification.",
  "main": "src/calc.js",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "check": "npm run lint && npm run workflow-pins:check && npm run test:unit:coverage && npm run test:list",
    "lint": "eslint . --max-warnings=0",
    "workflow-pins:check": "node .github/scripts/validate_workflow_pins.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --runInBand",
    "test:unit:coverage": "jest --runInBand --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed --project=chromium",
    "test:debug": "playwright test --debug --project=chromium --workers=1",
    "test:list": "playwright test --list",
    "report": "playwright show-report"
  },
  "license": "MIT",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "better-sqlite3@13.0.3": true,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "better-sqlite3": "13.0.3",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jest": "30.5.0",
    "playwright": "1.62.1",
    "supertest": "7.2.2"
  }
}
