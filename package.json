{
  "name": "qa-automation-node-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js test framework combining Playwright browser automation with unit, API, and data-layer verification.",
  "main": "src/calc.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --runInBand",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed --project=chromium",
    "test:debug": "playwright test --debug --project=chromium --workers=1",
    "test:list": "playwright test --list",
    "report": "playwright show-report"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "jest": "^29.7.0",
    "playwright": "^1.62.0",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2"
  }
}
